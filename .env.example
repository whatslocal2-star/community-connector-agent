# --- Commerce: Composio catalog sync + order push-back ---
# API key from dashboard.composio.dev
COMPOSIO_API_KEY=
# One auth config per platform (Composio dashboard → Auth Configs → New)
COMPOSIO_SHOPIFY_AUTH_CONFIG_ID=
COMPOSIO_SQUARE_AUTH_CONFIG_ID=
# Where Composio redirects the vendor after they authorize their store
MARKETPLACE_URL=https://your-marketplace-url

# --- Commerce: shared Supabase (xeno project — products / vendor_settings) ---
# Service-role key; these functions write the catalog the marketplace reads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Observability (optional; no-ops if unset) ---
# Sentry — server-side error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# PostHog — server-side product analytics for the agent
# (the marketplace app handles its own client-side analytics)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
