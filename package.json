{
  "name": "community-connector-agent",
  "version": "1.0.0",
  "description": "Vendor/shopper community connector chat agent",
  "type": "module",
  "scripts": {
    "test": "OPENAI_API_KEY=test PINECONE_API_KEY=test node --test tests/**/*.test.js",
    "test:e2e:search": "netlify dev:exec node tests/e2e-search.js",
    "test:e2e:onboarding": "netlify dev:exec node tests/e2e-onboarding.js",
    "test:e2e:backfill": "netlify dev:exec node tests/e2e-backfill.js",
    "test:e2e:complementary": "netlify dev:exec node tests/e2e-complementary.js",
    "test:e2e": "npm run test:e2e:search && npm run test:e2e:onboarding && npm run test:e2e:backfill && npm run test:e2e:complementary"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@netlify/blobs": "^8.1.0",
    "@netlify/functions": "^5.3.0",
    "@pinecone-database/pinecone": "^4.0.0",
    "@sentry/node": "^10.56.0",
    "@trigger.dev/sdk": "4.4.6",
    "firebase-admin": "^13.8.0",
    "openai": "^4.78.0",
    "posthog-node": "^5.36.2",
    "twilio": "^5.3.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1049.0"
  }
}
